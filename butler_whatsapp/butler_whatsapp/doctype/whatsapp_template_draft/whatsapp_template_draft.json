  {
   "fieldname": "header_sample",
   "fieldtype": "Data",
   "label": "Header variable sample",
   "depends_on": "eval:doc.header_type=='TEXT'"
  },
  {
   "fieldname": "sample_file",
   "fieldtype": "Attach",
