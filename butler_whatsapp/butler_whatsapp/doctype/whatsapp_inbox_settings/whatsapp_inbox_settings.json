 "fields": [
  {
   "fieldname": "access_section",
   "fieldtype": "Section Break",
   "label": "Access and Assignment"
  },
  {
   "fieldname": "supervisors",
   "fieldtype": "Table MultiSelect",
   "label": "Supervisors (see every conversation)",
   "options": "WhatsApp Inbox User",
   "description": "Other staff see only the conversations assigned to them, their teams' conversations and the ones they were added to. When the list is empty everybody sees everything."
  },
  {
   "fieldname": "notify_supervisors",
   "fieldtype": "Check",
   "label": "Also notify supervisors about assigned conversations",
   "default": "0"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "auto_assign",
   "fieldtype": "Select",
   "label": "Automatic assignment of new conversations",
   "options": "\nRound Robin",
   "default": "",
   "description": "Round Robin: every new conversation that no team keyword matched goes to the next person in the list below."
  },
  {
   "fieldname": "assign_pool",
   "fieldtype": "Table MultiSelect",
   "label": "Staff for automatic assignment",
   "options": "WhatsApp Inbox User",
   "depends_on": "eval:doc.auto_assign"
  },
  {
   "fieldname": "last_assigned",
   "fieldtype": "Data",
   "label": "Last assigned to",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "reopen_on_incoming",
   "fieldtype": "Check",
   "label": "Reopen a closed conversation when a new message arrives",
   "default": "1"
  },
  {
   "fieldname": "teams_section",
   "fieldtype": "Section Break",
   "label": "Teams and Routing",
   "description": "Teams (Sales, Maintenance, Installations, Accounts...) are managed in WhatsApp Team: members, keywords and how conversations are shared."
  },
  {
   "fieldname": "team_routing",
   "fieldtype": "Check",
   "default": "1",
   "label": "Route new conversations to teams by keywords"
  },
  {
   "fieldname": "ui_section",
   "fieldtype": "Section Break",
   "label": "Interface"
  },
  {
   "fieldname": "show_launcher",
   "fieldtype": "Check",
   "label": "Show the floating WhatsApp button",
   "default": "1",
   "description": "Every user can also drag the button anywhere or hide it from the WhatsApp page menu."
  },
  {
   "fieldname": "compliance_section",
   "fieldtype": "Section Break",
   "label": "Meta Policy (Consent and Opt-out)"
  },
  {
   "fieldname": "require_opt_in",
   "fieldtype": "Check",
   "label": "Block templates to customers without recorded consent",
   "default": "1",
   "description": "Meta policy: do not start a conversation with a template until the customer clearly agreed to receive Butler's messages. Inside the 24-hour window (the customer wrote to you) replying is always allowed."
  },
  {
   "fieldname": "incoming_is_opt_in",
   "fieldtype": "Check",
   "label": "Treat a customer's message to us as consent",
   "default": "0",
   "description": "Not recommended: Meta requires clear consent. Enable only if your policy is that whoever writes to you agrees to follow-ups."
  },
  {
   "fieldname": "opt_out_reply",
   "fieldtype": "Small Text",
   "label": "Opt-out confirmation reply (Arabic)",
   "default": "تم إيقاف رسائل باتلر على هذا الرقم. للعودة أرسل كلمة: اشتراك"
  },
  {
   "fieldname": "compliance_col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opt_out_keywords",
   "fieldtype": "Small Text",
   "label": "Opt-out keywords (one per line)",
   "default": "إيقاف\nايقاف\nإلغاء الاشتراك\nالغاء الاشتراك\nSTOP\nUNSUBSCRIBE",
   "description": "Matches the whole message only, so a message like \"I want to stop the order\" is not an opt-out."
  },
  {
   "fieldname": "opt_in_keywords",
   "fieldtype": "Small Text",
   "label": "Opt-in keywords",
   "default": "اشتراك\nSTART"
  },
  {
   "fieldname": "opt_in_reply",
   "fieldtype": "Small Text",
   "label": "Opt-in confirmation reply (Arabic)",
   "default": "تم تفعيل رسائل باتلر على هذا الرقم. شكراً لك."
  },
  {
   "fieldname": "english_texts_col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opt_out_reply_en",
   "fieldtype": "Small Text",
   "label": "Opt-out confirmation reply (English)",
   "default": "Butler's messages to this number have been stopped. To receive them again, send: START"
  },
  {
   "fieldname": "opt_in_reply_en",
   "fieldtype": "Small Text",
   "label": "Opt-in confirmation reply (English)",
   "default": "Butler's messages are enabled for this number. Thank you."
  },
